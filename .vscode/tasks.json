{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "locale",
      "type": "promptString",
      "description": "Locale for Docusaurus translations",
      "default": "en"
    }
  ],
  "tasks": [
    {
      "label": "install",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "docusaurus write-translations",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "write-translations",
        "--",
        "--locale",
        "${input:locale}"
      ],
      "problemMatcher": []
    }
  ]
}
