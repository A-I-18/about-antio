{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "startLocale",
      "type": "promptString",
      "description": "Locale for the Docusaurus development server",
      "default": "it"
    }
  ],
  "configurations": [
    {
      "name": "docusaurus start",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run start -- --locale ${input:startLocale}",
      "env": {
        "DOCUSAURUS_BROWSER": "Brave Browser"
      }
    },
    {
      "name": "docusaurus serve",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run serve",
      "preLaunchTask": "build"
    }
  ]
}
